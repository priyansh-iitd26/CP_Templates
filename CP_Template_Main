int power(int a, int x) {
    int result = 1;
    while(x > 0){
        if(x & 1) result = (result * a) % MOD;
        a = (a * a) % MOD;
        x >>= 1;
    }
    return result;
}

int multiply(int x, int y){
    return (x * 1LL * y) % MOD;
}

int modInverse(int n){
